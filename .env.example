# Copy this file to .env and fill in the section for whichever provider
# you're using. NEVER commit your real .env file.

# Pick one: anthropic | gemini | ollama
MODEL_PROVIDER=anthropic

# --- Anthropic (paid, no persistent free tier) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-5

# --- Gemini (recommended free option — no credit card required) ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemini-flash-latest is Google's rolling alias — it always points at the
# current stable Flash model, so it won't go stale/404 the way a pinned
# version eventually does when Google retires that specific model. Pin an
# exact version (e.g. gemini-3.5-flash) instead if you want reproducible
# behavior rather than auto-updates.
GEMINI_MODEL=gemini-flash-latest

# --- Ollama (fully local, no API key, no internet needed after model pull) ---
# If running via docker-compose, leave OLLAMA_HOST as-is — it points at the
# bundled `ollama` service. If running natively (no Docker), use
# http://localhost:11434 instead.
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.1

# Applies to all providers
PLAYGROUND_MAX_TOOL_TURNS=10
